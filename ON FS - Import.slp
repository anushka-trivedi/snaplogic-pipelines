                    }
                },
                "info": {
                    "label": {
                        "value": "Mapper - Style"
                    },
                    "notes": {}
                },
                "input": {
                    "input0": {
                        "label": {
                            "value": "input0"
                        },
                        "view_type": {
                            "value": "document"
                        }
                    }
                },
                "output": {
                    "output0": {
                        "label": {
                            "value": "output0"
                        },
                        "view_type": {
                            "value": "document"
                        }
                    }
                },
                "settings": {
                    "execution_mode": {
                        "value": "Validate & Execute"
                    },
                    "nullSafeAccess": {
                        "value": true
                    },
                    "passThrough": {
                        "value": true
                    },
                    "transformations": {
                        "value": {
                            "mappingRoot": {
                                "value": "$"
                            },
                            "mappingTable": {
                                "value": [
                                    {
                                        "expression": {
                                            "expression": true,
                                            "value": "$style.code"
                                        },
                                        "targetPath": {
                                            "value": "$attributes.thgstylecode.value"
                                        }
                                    },
                                    {
                                        "expression": {
                                            "expression": true,
                                            "value": "$style.name"
                                        },
                                        "targetPath": {
                                            "value": "$attributes.thgstylename.value"
                                        }
                                    },
                                    {
                                        "expression": {
                                            "expression": true,
                                            "value": "$style.type"
                                        },
                                        "targetPath": {
                                            "value": "$attributes.thgstyletype.value"
                                        }
                                    },
                                    {
                                        "expression": {
                                            "expression": true,
                                            "value": "$style.category"
                                        },
                                        "targetPath": {
                                            "value": "$attributes.thgcategoryname.value"
                                        }
                                    },
                                    {
                                        "expression": {
                                            "expression": true,
                                            "value": "$style.vertical"
                                        },
                                        "targetPath": {
                                            "value": "$attributes.thgverticalname.value"
                                        }
                                    },
                                    {
                                        "expression": {
                                            "expression": true,
                                            "value": "$style.gender"
                                        },
                                        "targetPath": {
                                            "value": "$attributes.thggender.value"
                                        }
                                    },
                                    {
                                        "expression": {
                                            "expression": true,
                                            "value": "$style.seasonal_attributes.map(seasonal => ({\n\n  ...(seasonal.season && seasonal.season.code\n    ? { thgnestedseasoncode: seasonal.season.code }\n    : {}),\n\n  ...(seasonal.is_active != null\n    ? { thgnestedstylestatus: seasonal.is_active }\n    : {}),\n\n  ...(seasonal.origin_country && seasonal.origin_country.name\n    ? { thgnestedcountryoforigin: seasonal.origin_country.name }\n    : {}),\n\n  ...(seasonal.target_free_on_board_price !=null\n      && seasonal.target_free_on_board_price.amount != null\n    ? { thgnestedtargetfob: seasonal.target_free_on_board_price.amount }\n    : {}),\n\n  ...(seasonal.target_margin_percentage != null\n    ? { thgnestedtargetmargin: seasonal.target_margin_percentage }\n    : {}),\n\n  ...(seasonal.target_recommended_retail_price !=null\n      && seasonal.target_recommended_retail_price.amount != null\n    ? { thgnestedtargetrrp: seasonal.target_recommended_retail_price.amount }\n    : {}),\n\n  ...(seasonal.update\n    ? { thgnestedstyleupdate: seasonal.update }\n    : {}),\n\n  ...(seasonal.franchise_collection_type\n    ? { thgnestedfrcollectiontype: seasonal.franchise_collection_type}\n    : {}),\n\n  ...(seasonal.model_type\n    ? { thgnestedmodeltype: seasonal.model_type}\n    : {}),\n \n  ...(seasonal.target_volume !=null\n    ? { thgnestedtargetvolume: seasonal.target_volume}\n    : {}),\n\n  ...(seasonal.dev_stage\n    ? { thgnesteddevstage: seasonal.dev_stage}\n    : {}),\n\n  ...(seasonal.is_flr_ready !=null\n    ? { thgnestedstyleflrready: seasonal.is_flr_ready}\n    : {}),\n\n  ...(seasonal.is_flr_selected !=null\n    ? { thgnestedstyleflrselected: seasonal.is_flr_selected}\n    : {})\n\n}))"
                                        },
                                        "targetPath": {
                                            "value": "$attributes.thgseasonalstyle.value"
                                        }
                                    },
                                    {
                                        "expression": {
                                            "expression": true,
                                            "value": "$style.collection"
                                        },
                                        "targetPath": {
                                            "value": "$attributes.thgcollection.value"
                                        }
                                    },
                                    {
                                        "expression": {
                                            "expression": true,
                                            "value": "$style.generation"
                                        },
                                        "targetPath": {
                                            "value": "$attributes.thggeneration.value"
                                        }
                                    },
                                    {
                                        "expression": {
                                            "expression": true,
                                            "value": "$style.model_name"
                                        },
                                        "targetPath": {
                                            "value": "$attributes.thgmodelname.value"
                                        }
                                    },
                                    {
                                        "expression": {
                                            "expression": true,
                                            "value": "$style.sub_category"
                                        },
                                        "targetPath": {
                                            "value": "$attributes.thgsubcategory.value"
                                        }
                                    },
                                    {
                                        "expression": {
                                            "expression": true,
                                            "value": "$style.is_waterproof"
                                        },
                                        "targetPath": {
                                            "value": "$attributes.thgwaterprooftag.value"
                                        }
                                    },
                                    {
                                        "expression": {
                                            "expression": true,
                                            "value": "$style.franchise"
                                        },
                                        "targetPath": {
                                            "value": "$attributes.thgfrancise.value"
                                        }
                                    },
                                    {
                                        "expression": {
                                            "expression": true,
                                            "value": "$style.community"
                                        },
                                        "targetPath": {
                                            "value": "$attributes.thgcommunity.value"
                                        }
                                    },
                                    {
                                        "expression": {
                                            "expression": true,
                                            "value": "$style.width_standard"
                                        },
                                        "targetPath": {
                                            "value": "$attributes.thgwidthstandard.value"
                                        }
                                    },
                                    {
                                        "expression": {
                                            "expression": true,
                                            "value": "$style.range_type"
                                        },
                                        "targetPath": {
                                            "value": "$attributes.thgrangetype.value"
                                        }
                                    },
                                    {
                                        "expression": {
                                            "expression": true,
                                            "value": "$style.group"
                                        },
                                        "targetPath": {
                                            "value": "$attributes.thggroup.value"
                                        }
                                    },
                                    {
                                        "expression": {
                                            "expression": true,
                                            "value": "$style.unit"
                                        },
                                        "targetPath": {
                                            "value": "$attributes.thgunit.value"
                                        }
                                    },
                                    {
                                        "expression": {
                                            "expression": true,
                                            "value": "$style.size_range.code"
                                        },
                                        "targetPath": {
                                            "value": "$attributes.thgsizerange.value"
                                        }
                                    },
                                    {
                                        "expression": {
                                            "expression": true,
                                            "value": "$style.dimension"
                                        },
                                        "targetPath": {
                                            "value": "$attributes.thgdimension.value"
                                        }
                                    },
                                    {
                                        "expression": {
                                            "expression": true,
