                                            "value": "$attributes.thguniqueproductidentifier.value"
                                        }
                                    },
                                    {
                                        "expression": {
                                            "expression": true,
                                            "value": "$code"
                                        },
                                        "targetPath": {
                                            "value": "$attributes.thgproductcode.value"
                                        }
                                    },
                                    {
                                        "expression": {
                                            "expression": true,
                                            "value": "$name"
                                        },
                                        "targetPath": {
                                            "value": "$attributes.thgproductname.value"
                                        }
                                    },
                                    {
                                        "expression": {
                                            "expression": true,
                                            "value": "$sales_color_name"
                                        },
                                        "targetPath": {
                                            "value": "$attributes.thgsalescolorname.value"
                                        }
                                    },
                                    {
                                        "expression": {
                                            "expression": true,
                                            "value": "$sales_color_code"
                                        },
                                        "targetPath": {
                                            "value": "$attributes.thgsalescolorcode.value"
                                        }
                                    },
                                    {
                                        "expression": {
                                            "expression": true,
                                            "value": "$primary_color.code"
                                        },
                                        "targetPath": {
                                            "value": "$attributes.thgprimarycolornamecode.value"
                                        }
                                    },
                                    {
                                        "expression": {
                                            "expression": true,
                                            "value": "$secondary_color.code"
                                        },
                                        "targetPath": {
                                            "value": "$attributes.thgsecondarycolornamecode.value"
                                        }
                                    },
                                    {
                                        "expression": {
                                            "expression": true,
                                            "value": "$seasonal_attributes.map(seasonal => ({\n  \n  ...(seasonal.season && seasonal.season.code\n    ? { thgnestedproductseasoncode: seasonal.season.code }\n    : {}),\n\n  ...(seasonal.update\n    ? { thgnestedcolorupdate: seasonal.update }\n    : {}),\n\n  ...(seasonal.is_marketing_product !=null\n    ? { thgnestedkeycampaignitem: seasonal.is_marketing_product }\n    : {}),\n\n...(seasonal.target_volume_split_percentage != null\n    ? { thgnestedsplitpercentage: seasonal.target_volume_split_percentage }\n    : {}),\n\n  ...(seasonal.is_active != null\n    ? { thgnestedproductstatus: seasonal.is_active }\n    : {}),\n\n  ...(seasonal.sales_availability\n    ? { thgnestedsalesavailability: seasonal.sales_availability }\n    : {}),\n\n\n  ...(seasonal.launch_at\n    ? { thgnestedretaillaunchdate: Date.UTC(1970, 0, 1).plusDays(seasonal.launch_at).toLocaleDateString({\"format\": \"yyyy-MM-dd\"}) }\n    : {}),\n\n\n  ...(seasonal.target_volume_from_line_plan!=null\n    ? { thgproductnestedtargetvolume: seasonal.target_volume_from_line_plan}\n    : {}),\n\n  ...(seasonal.is_flr_ready !=null\n    ? { thgnestedcolorflrready: seasonal.is_flr_ready}\n    : {}),\n\n  ...(seasonal.is_flr_selected !=null\n    ? { thgnestedcolorflrselected: seasonal.is_flr_selected}\n    : {})\n\n}))"
                                        },
                                        "targetPath": {
                                            "value": "$attributes.thgproductseasonal.value"
                                        }
                                    },
                                    {
                                        "expression": {
                                            "expression": true,
                                            "value": "$development_color_name"
                                        },
                                        "targetPath": {
                                            "value": "$attributes.thgdevcolorname.value"
                                        }
                                    },
                                    {
                                        "expression": {
                                            "expression": true,
                                            "value": "$intro_season_code.code"
                                        },
                                        "targetPath": {
                                            "value": "$attributes.thgintroseason.value"
                                        }
                                    },
                                    {
                                        "expression": {
                                            "expression": true,
                                            "value": "$launch_at != null  ? Date.UTC(1970, 0, 1).plusDays($launch_at).toLocaleDateString({\"format\": \"yyyy-MM-dd\"})  : null"
                                        },
                                        "targetPath": {
                                            "value": "$attributes.thglaunchdate.value"
                                        }
                                    },
                                    {
                                        "expression": {
                                            "expression": true,
                                            "value": "$drop_out_at!= null  ? Date.UTC(1970, 0, 1).plusDays($drop_out_at).toLocaleDateString({\"format\": \"yyyy-MM-dd\"})  : null"
                                        },
                                        "targetPath": {
                                            "value": "$attributes.thgdropoutdate.value"
                                        }
                                    },
                                    {
                                        "expression": {
                                            "expression": true,
                                            "value": "$life_cycle_length"
                                        },
                                        "targetPath": {
                                            "value": "$attributes.thglifecycle.value"
                                        }
                                    },
                                    {
                                        "expression": {
                                            "expression": true,
                                            "value": "$is_special_packaging"
                                        },
                                        "targetPath": {
                                            "value": "$attributes.thgspecialpackaging.value"
                                        }
                                    },
                                    {
                                        "expression": {
                                            "expression": true,
                                            "value": "$is_mono_color"
                                        },
                                        "targetPath": {
                                            "value": "$attributes.thgmonocolor.value"
                                        }
                                    },
                                    {
                                        "expression": {
                                            "expression": true,
                                            "value": "$style.code"
                                        },
                                        "targetPath": {
                                            "value": "$attributes.thgstylecode.value"
                                        }
                                    },
                                    {
                                        "expression": {
                                            "expression": true,
                                            "value": "$style.name"
                                        },
                                        "targetPath": {
                                            "value": "$attributes.thgstylename.value"
                                        }
                                    },
                                    {
                                        "expression": {
                                            "expression": true,
                                            "value": "$style.seasonal_attributes.map(seasonal => ({\n\n  ...(seasonal.season && seasonal.season.code\n    ? { thgnestedseasoncode: seasonal.season.code }\n    : {}),\n\n  ...(seasonal.is_active != null\n    ? { thgnestedstylestatus: seasonal.is_active }\n    : {}),\n\n  ...(seasonal.origin_country && seasonal.origin_country.name\n    ? { thgnestedcountryoforigin: seasonal.origin_country.name }\n    : {}),\n\n  ...(seasonal.target_free_on_board_price !=null\n      && seasonal.target_free_on_board_price.amount != null\n    ? { thgnestedtargetfob: seasonal.target_free_on_board_price.amount }\n    : {}),\n\n  ...(seasonal.target_margin_percentage != null\n    ? { thgnestedtargetmargin: seasonal.target_margin_percentage }\n    : {}),\n\n  ...(seasonal.target_recommended_retail_price !=null\n      && seasonal.target_recommended_retail_price.amount != null\n    ? { thgnestedtargetrrp: seasonal.target_recommended_retail_price.amount }\n    : {}),\n\n  ...(seasonal.update\n    ? { thgnestedstyleupdate: seasonal.update }\n    : {}),\n\n  ...(seasonal.franchise_collection_type\n    ? { thgnestedfrcollectiontype: seasonal.franchise_collection_type}\n    : {}),\n\n  ...(seasonal.model_type\n    ? { thgnestedmodeltype: seasonal.model_type}\n    : {}),\n \n  ...(seasonal.target_volume !=null\n    ? { thgnestedtargetvolume: seasonal.target_volume}\n    : {}),\n\n  ...(seasonal.dev_stage\n    ? { thgnesteddevstage: seasonal.dev_stage}\n    : {}),\n\n  ...(seasonal.is_flr_ready !=null\n    ? { thgnestedstyleflrready: seasonal.is_flr_ready}\n    : {}),\n\n  ...(seasonal.is_flr_selected !=null\n    ? { thgnestedstyleflrselected: seasonal.is_flr_selected}\n    : {})\n\n}))"
                                        },
                                        "targetPath": {
                                            "value": "$attributes.thgseasonalstyle.value"
                                        }
                                    },
                                    {
                                        "expression": {
                                            "expression": true,
                                            "value": "$style.collection"
                                        },
                                        "targetPath": {
                                            "value": "$attributes.thgcollection.value"
                                        }
                                    },
                                    {
                                        "expression": {
                                            "expression": true,
                                            "value": "$style.community"
                                        },
                                        "targetPath": {
                                            "value": "$attributes.thgcommunity.value"
                                        }
                                    },
                                    {
                                        "expression": {
                                            "expression": true,
                                            "value": "$style.franchise"
                                        },
                                        "targetPath": {
                                            "value": "$attributes.thgfrancise.value"
                                        }
                                    },
                                    {
                                        "expression": {
                                            "expression": true,
                                            "value": "$style.gender"
                                        },
                                        "targetPath": {
                                            "value": "$attributes.thggender.value"
                                        }
                                    },
                                    {
                                        "expression": {
                                            "expression": true,
                                            "value": "$style.generation"
                                        },
                                        "targetPath": {
                                            "value": "$attributes.thggeneration.value"
                                        }
                                    },
                                    {
                                        "expression": {
                                            "expression": true,
                                            "value": "$style.group"
                                        },
                                        "targetPath": {
                                            "value": "$attributes.thggroup.value"
                                        }
                                    },
                                    {
                                        "expression": {
                                            "expression": true,
                                            "value": "$style.model_name"
                                        },
                                        "targetPath": {
                                            "value": "$attributes.thgmodelname.value"
                                        }
                                    },
                                    {
                                        "expression": {
                                            "expression": true,
                                            "value": "$style.range_type"
                                        },
                                        "targetPath": {
                                            "value": "$attributes.thgrangetype.value"
                                        }
                                    },
                                    {
                                        "expression": {
                                            "expression": true,
                                            "value": "$style.type"
                                        },
                                        "targetPath": {
                                            "value": "$attributes.thgstyletype.value"
                                        }
                                    },
                                    {
                                        "expression": {
                                            "expression": true,
                                            "value": "$style.unit"
                                        },
                                        "targetPath": {
                                            "value": "$attributes.thgunit.value"
                                        }
                                    },
                                    {
                                        "expression": {
                                            "expression": true,
                                            "value": "$style.vertical"
                                        },
                                        "targetPath": {
                                            "value": "$attributes.thgverticalname.value"
                                        }
                                    },
                                    {
                                        "expression": {
                                            "expression": true,
                                            "value": "$style.dimension"
                                        },
                                        "targetPath": {
                                            "value": "$attributes.thgdimension.value"
                                        }
                                    },
                                    {
                                        "expression": {
                                            "expression": true,
                                            "value": "$style.fedas_class"
                                        },
                                        "targetPath": {
                                            "value": "$attributes.thgfedasclass.value"
                                        }
                                    },
                                    {
                                        "expression": {
                                            "expression": true,
                                            "value": "$style.category"
                                        },
                                        "targetPath": {
                                            "value": "$attributes.thgcategoryname.value"
                                        }
                                    },
                                    {
                                        "expression": {
                                            "expression": true,
                                            "value": "$style.size_range.code"
                                        },
                                        "targetPath": {
                                            "value": "$attributes.thgsizerange.value"
                                        }
                                    }
                                ]
                            }
                        }
                    }
                },
                "view_serial": 100
            }
        },
