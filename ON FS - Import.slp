                        "value": "'processing/' + $sourceObjectKey"
                    },
                    "passThrough": {
                        "value": false
                    },
                    "showAdvancedProperties": {
                        "value": false
                    },
                    "threadPoolSize": {
                        "expression": false,
                        "value": 10
                    }
                },
                "view_serial": 100
            }
        }
    }
}
