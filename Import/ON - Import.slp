                    }
                },
                "info": {
                    "label": {
                        "value": "Mapper: Variant -> Product"
                    },
                    "notes": {}
                },
                "input": {
                    "input0": {
                        "label": {
                            "value": "input0"
                        },
                        "view_type": {
                            "value": "document"
                        }
                    }
                },
                "output": {
                    "output0": {
                        "label": {
                            "value": "output0"
                        },
                        "view_type": {
                            "value": "document"
                        }
                    }
                },
                "settings": {
                    "execution_mode": {
                        "value": "Validate & Execute"
                    },
                    "nullSafeAccess": {
                        "value": false
                    },
                    "passThrough": {
                        "value": false
                    },
                    "transformations": {
                        "value": {
                            "mappingRoot": {
                                "value": "$"
                            },
                            "mappingTable": {
                                "value": [
                                    {
                                        "expression": {
                                            "expression": true,
                                            "value": "$group.find(x => x.entity_type == \"product\")\n? {\n    items: $group\n      .filter(x => x.entity_type == \"variant\")\n      .map(v => ({\n        id: v.entity_id,\n\n        type: \"variant\",\n\n        data: {\n          attributes: {\n            thgvariantcode: {\n              values: [\n                {\n                  value: v.thgvariantcode,\n                  locale: v.thgvariantcode_locale\n                }\n              ]\n            }\n          },\n\n          relationships: {\n            relproductvariant: [\n              {\n                relTo: {\n                  id: $group.find(x => x.entity_type == \"product\").entity_id,\n                  type: \"product\"\n                }\n              }\n            ]\n          }\n        }\n      }))\n  }\n: {\n    items: [] \n  }"
                                        },
                                        "targetPath": {
                                            "value": "$"
                                        }
                                    }
                                ]
                            }
                        }
                    }
                },
                "view_serial": 100
            }
        },
