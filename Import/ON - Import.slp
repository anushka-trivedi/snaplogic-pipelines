                                            "value": "$intro_season_code.code"
                                        },
                                        "targetPath": {
                                            "value": "$attributes.thgintroseason.value"
                                        }
                                    },
                                    {
                                        "expression": {
                                            "expression": true,
                                            "value": "$launch_at != null  ? Date.UTC(1970, 0, 1).plusDays($launch_at).toLocaleDateString({\"format\": \"yyyy-MM-dd\"})  : null"
                                        },
                                        "targetPath": {
                                            "value": "$attributes.thglaunchdate.value"
                                        }
                                    },
