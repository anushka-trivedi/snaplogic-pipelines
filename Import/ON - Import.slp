                                            "expression": true,
                                            "value": "$group.find(x => x.entity_type == \"product\") && $group.find(x => x.entity_type == \"style\")\n? {\n    id: $group.find(x => x.entity_type == \"product\").entity_id,\n    type: \"product\",\n\n    data: {\n      attributes: {\n        thguniqueproductidentifier: {\n          values: [\n            {\n              value: $group.find(x => x.entity_type == \"product\").thguniqueproductidentifier,\n              locale: $group.find(x => x.entity_type == \"product\").identifier_locale\n            }\n          ]\n        },\n\n        thgproductcode: {\n          values: [\n            {\n              value: $group.find(x => x.entity_type == \"product\").product_code,\n              locale: $group.find(x => x.entity_type == \"product\").code_locale\n            }\n          ]\n        }\n      },\n\n      relationships: {\n        relischildof: [\n          {\n            relTo: {\n              id: $group.find(x => x.entity_type == \"style\").entity_id,\n              type: \"style\"\n            }\n          }\n        ]\n      }\n    }\n  }\n: {\n    skip: true\n  }"
