        "11111111-1111-1111-1111-000000000022": {
            "class_id": "com-snaplogic-snaps-script-script",
            "class_version": 2,
            "instance_id": "11111111-1111-1111-1111-000000000022",
            "property_map": {
                "error": {
                    "error0": {
                        "label": {
                            "value": "error0"
