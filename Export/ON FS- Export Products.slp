                                        "expression": {
                                            "expression": true,
                                            "value": "$input2 && $input2.length > 0\n?\n$input2.map(p => ({\n\n  ...p,\n\n  style:\n\n    $input0 && $input0.length > 0\n    ?\n\n    (\n      $input0.find(s =>\n        s.style &&\n        s.style.code &&\n        p.code.startsWith(s.style.code)\n      )\n      ?\n      $input0.find(s =>\n        s.style &&\n        s.style.code &&\n        p.code.startsWith(s.style.code)\n      ).style\n      :\n      {}\n    )\n\n    :\n\n    {},\n\n  variants:\n\n    $input1 && $input1.length > 0\n    ?\n\n    $input1\n      .filter(v =>\n        v.variants &&\n        v.variants.length > 0 &&\n        v.variants[0].code &&\n        v.variants[0].code.startsWith(p.code)\n      )\n      .map(v => v.variants)\n      .reduce((a, b) => a.concat(b), [])\n\n    :\n\n    []\n\n}))\n:\n[]"
                                        },
