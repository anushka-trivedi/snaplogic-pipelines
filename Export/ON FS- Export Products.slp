                                            "expression": true,
                                            "value": "{\n  code:\n    $data.attributes.get('thgproductcode') &&\n    $data.attributes.thgproductcode.values[0].value\n      ? $data.attributes.thgproductcode.values[0].value\n      : \"\",\n\n  name:\n    $data.attributes.get('thgproductname') &&\n    $data.attributes.thgproductname.values[0].value\n      ? $data.attributes.thgproductname.values[0].value\n      : \"\",\n\n  sales_color: {\n    code:\n      $data.attributes.get('thgsalescolorcode') &&\n      $data.attributes.thgsalescolorcode.values[0].value\n        ? $data.attributes.thgsalescolorcode.values[0].value\n        : \"\",\n\n    name:\n      $data.attributes.get('thgsalescolorname') &&\n      $data.attributes.thgsalescolorname.values[0].value\n        ? $data.attributes.thgsalescolorname.values[0].value\n        : \"\"\n  },\n\nprimary_color: {\n  code:\n    $data.attributes.get('thgprimarycolornamecode') &&\n      $data.attributes.thgprimarycolornamecode.values[0].value\n        ? $data.attributes.thgprimarycolornamecode.values[0].value\n        : \"\",\n\n  name:\n    $primaryColor && $original.colorLookup[$primaryColor]\n      ? $original.colorLookup[$primaryColor].name\n      : \"\",\n\n  hex:\n    $primaryColor && $original.colorLookup[$primaryColor]\n      ? $original.colorLookup[$primaryColor].hex\n      : \"\",\n\n  library:\n    $primaryColor && $original.colorLookup[$primaryColor]\n      ? $original.colorLookup[$primaryColor].library\n      : \"\",\n\n  nrf_code:\n    $primaryColor && $original.colorLookup[$primaryColor]\n      ? $original.colorLookup[$primaryColor].nrf_code\n      : \"\"\n},\n\n\n\n  secondary_color: {\n    code:\n      $data.attributes.get('thgsecondarycolornamecode') &&\n      $data.attributes.thgsecondarycolornamecode.values[0].value\n        ? $data.attributes.thgsecondarycolornamecode.values[0].value\n        : \"\",\n\n     name:\n    $secondaryColor && $original.colorLookup[$secondaryColor]\n      ? $original.colorLookup[$secondaryColor].name\n      : \"\",\n\n  hex:\n    $secondaryColor && $original.colorLookup[$secondaryColor]\n      ? $original.colorLookup[$secondaryColor].hex\n      : \"\",\n\n  library:\n    $secondaryColor && $original.colorLookup[$secondaryColor]\n      ? $original.colorLookup[$secondaryColor].library\n      : \"\",\n\n  nrf_code:\n    $secondaryColor && $original.colorLookup[$secondaryColor]\n      ? $original.colorLookup[$secondaryColor].nrf_code\n      : \"\"\n\n  },\n\n  seasonal_attributes:\n    $data.attributes.thgproductseasonal.group\n      .filter(seasonal =>\n\n        $data.attributes.thgsysseasonalproduct.group.find(sys =>\n\n          sys.thgsysnestedproductseasoncode.values[0].value ==\n          seasonal.thgnestedproductseasoncode.values[0].value\n\n          &&\n\n         [\n               \"Confirmed\",\n               \"Confirmed Pending Changes\",\n               \"Cancelled\"\n          ].indexOf( sys.thgsysnestedproductlifcyclestatus.values[0].value ) >= 0\n\n        )\n\n      )\n      .map(seasonal => ({\n\n        season: {\n          season: {\n  \"SP\": \"SEASON_PERIOD_SPRING_SUMMER\",\n  \"FA\": \"SEASON_PERIOD_FALL_WINTER\"\n}[seasonal.thgnestedproductseasoncode.values[0].value.substring(4)] || \"\",\n\n          year: parseInt(seasonal.thgnestedproductseasoncode.values[0].value.substring(0,4)),\n\n          code:\n            seasonal.thgnestedproductseasoncode.values[0].value || \"\"\n        },\n\n        update:\n          seasonal.thgnestedcolorupdate.values[0].properties.referenceDataIdentifier || \"\",\n\n        is_marketing_product:\n          seasonal.thgnestedkeycampaignitem.values[0].value != null ? seasonal.thgnestedkeycampaignitem.values[0].value: \"\",\n\n       target_volume_split_percentage:  seasonal.thgnestedsplitpercentage.values[0].value != null ? seasonal.thgnestedsplitpercentage.values[0].value: \"\",\n\n        is_active:\n          seasonal.thgnestedproductstatus.values[0].value != null ? seasonal.thgnestedproductstatus.values[0].value: \"\",\n\n        sales_availability:\n          seasonal.thgnestedsalesavailability.values[0].properties.referenceDataIdentifier || \"\",\n\n         launch_at: seasonal.thgnestedretaillaunchdate.values[0].value != null\n  ? Math.floor(\n      (\n        Date.parse(seasonal.thgnestedretaillaunchdate.values[0].value).getTime()\n        - Date.UTC(1970, 0, 1).getTime()\n      ) / 86400000\n    )\n  : \"\",\n\n       unique_product_id: $data.attributes.get('thguniqueproductidentifier') &&\n    $data.attributes.thguniqueproductidentifier.values[0].value\n      ? $data.attributes.thguniqueproductidentifier.values[0].value\n      : \"\",\n\n       target_volume_from_line_plan: seasonal.thgproductnestedtargetvolume.values[0].value != null ? seasonal.thgproductnestedtargetvolume.values[0].value: \"\",\n\n       \"is_flr_ready\": seasonal.thgnestedcolorflrready.values[0].value != null ? seasonal.thgnestedcolorflrready.values[0].value: \"\",\n\n       \"is_flr_selected\": seasonal.thgnestedcolorflrselected.values[0].value != null ? seasonal.thgnestedcolorflrselected.values[0].value: \"\"\n\n      })),\n\n  development_color_name:\n    $data.attributes.get('thgdevcolorname') &&\n    $data.attributes.thgdevcolorname.values[0].value\n      ? $data.attributes.thgdevcolorname.values[0].value\n      : \"\",\n\nintro_season_code:\n  $data.attributes.get('thgintroseason') &&\n  $data.attributes.thgintroseason.values &&\n  $data.attributes.thgintroseason.values.length > 0 &&\n  $data.attributes.thgintroseason.values[0].properties.referenceDataIdentifier\n    ? {\n        season: {\n          \"SP\": \"SEASON_PERIOD_SPRING_SUMMER\",\n          \"FA\": \"SEASON_PERIOD_FALL_WINTER\"\n        }[\n          $data.attributes.thgintroseason.values[0]\n            .properties.referenceDataIdentifier.substring(4)\n        ] || \"\",\n\n        year: parseInt(\n          $data.attributes.thgintroseason.values[0]\n            .properties.referenceDataIdentifier.substring(0,4)\n        ),\n\n        code:\n          $data.attributes.thgintroseason.values[0]\n            .properties.referenceDataIdentifier\n      }\n    : null , \n\nlaunch_at:\n  $data.attributes.thglaunchdate.values[0].value != null\n  ? Math.floor(\n      (\n        Date.parse($data.attributes.thglaunchdate.values[0].value).getTime()\n        - Date.UTC(1970, 0, 1).getTime()\n      ) / 86400000\n    )\n  : \"\",\n\ndrop_out_at:\n  $data.attributes.thgdropoutdate.values[0].value != null\n  ? Math.floor(\n      (\n        Date.parse($data.attributes.thgdropoutdate.values[0].value).getTime()\n        - Date.UTC(1970, 0, 1).getTime()\n      ) / 86400000\n    )\n  : \"\",\n\nlife_cycle_length: $.data.attributes.get('thglifecycle') &&\n          $.data.attributes.thglifecycle.values[0].properties.referenceDataIdentifier\n      ? $.data.attributes.thglifecycle.values[0].properties.referenceDataIdentifier\n      : \"\",\n\n  is_special_packaging:\n    $.data.attributes.get('thgspecialpackaging') &&\n    $.data.attributes.thgspecialpackaging.values &&\n    $.data.attributes.thgspecialpackaging.values.length > 0\n      ? $.data.attributes.thgspecialpackaging.values[0].value\n      : \"\",\n\n  is_mono_color:\n    $.data.attributes.get('thgmonocolor') &&\n    $.data.attributes.thgmonocolor.values &&\n    $.data.attributes.thgmonocolor.values.length > 0\n      ? $.data.attributes.thgmonocolor.values[0].value\n      : \"\",\n\n unique_product_id:  $data.attributes.get('thguniqueproductidentifier') &&\n    $data.attributes.thguniqueproductidentifier.values[0].value\n      ? $data.attributes.thguniqueproductidentifier.values[0].value\n      : \"\",\n\n \"sales_color_code\": $data.attributes.get('thgsalescolorcode') &&\n      $data.attributes.thgsalescolorcode.values[0].value\n        ? $data.attributes.thgsalescolorcode.values[0].value\n        : \"\",\n \"sales_color_name\": $data.attributes.get('thgsalescolorname') &&\n      $data.attributes.thgsalescolorname.values[0].v